+Client *
+tile_neighbor(int dir)
+{
+	int x, y, step = (gaps ? (int)gappx : 0) + 2;
+	Client *c, *sel = focustop(selmon);
+	if (!sel || !selmon)
+		return NULL;
+
+	if (dir == DIR_LEFT || dir == DIR_RIGHT) {
+		x = (dir == DIR_LEFT) ? sel->geom.x - step : sel->geom.x + sel->geom.width + step;
+		wl_list_for_each(c, &fstack, flink) {
+			if (c != sel && VISIBLEON(c, selmon) && !c->isfloating && !c->isfullscreen &&
+					c->geom.x <= x && x < c->geom.x + c->geom.width &&
+					c->geom.y < sel->geom.y + sel->geom.height &&
+					c->geom.y + c->geom.height > sel->geom.y)
+				return c;
+		}
+	} else if (dir == DIR_UP || dir == DIR_DOWN) {
+		y = (dir == DIR_UP) ? sel->geom.y - step : sel->geom.y + sel->geom.height + step;
+		wl_list_for_each(c, &fstack, flink) {
+			if (c != sel && VISIBLEON(c, selmon) && !c->isfloating && !c->isfullscreen &&
+					c->geom.y <= y && y < c->geom.y + c->geom.height &&
+					c->geom.x < sel->geom.x + sel->geom.width &&
+					c->geom.x + c->geom.width > sel->geom.x)
+				return c;
+		}
+	}
+	return NULL;
+}
