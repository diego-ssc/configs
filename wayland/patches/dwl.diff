+void
+drawbar(Monitor *m)
+{
+	int x, w, tw = 0, msx;
+	int boxs = m->drw->font->height / 9;
+	int boxw = m->drw->font->height / 6 + 2;
+	uint32_t i, occ = 0, urg = 0;
+	char stext_buf[256], *mstext = NULL, *rstext = NULL, *saveptr = NULL;
+	Client *c;
+	Buffer *buf;
+
+	if (!m->scene_buffer->node.enabled)
+		return;
+	if (!(buf = bufmon(m)))
+		return;
+
+	drwl_setscheme(m->drw, colors[SchemeNorm]);
+	drwl_rect(m->drw, 0, 0, m->b.width, m->b.height, 1, 1);
+
+	if (stext[0] != '\0') {
+		strncpy(stext_buf, stext, sizeof(stext_buf) - 1);
+		stext_buf[sizeof(stext_buf) - 1] = '\0';
+		mstext = strtok_r(stext_buf, splitdelim, &saveptr);
+		rstext = strtok_r(NULL, splitdelim, &saveptr);
+
+		if (mstext) {
+			tw = TEXTW(m, mstext) - m->lrpad;
+			msx = (m->b.width - tw) / 2;
+			drwl_text(m->drw, msx, 0, tw, m->b.height, 0, mstext, 0);
+		}
+		if (rstext) {
+			tw = TEXTW(m, rstext) - m->lrpad + 2;
+			drwl_text(m->drw, m->b.width - tw, 0, tw, m->b.height, 0, rstext, 0);
+		}
+	}
+
+	wl_list_for_each(c, &clients, link) {
+		occ |= c->tags;
+		if (c->isurgent)
+			urg |= c->tags;
+	}
+	x = 0;
+	c = focustop(m);
+	for (i = 0; i < LENGTH(tags); i++) {
+		w = TEXTW(m, tags[i]);
+		drwl_setscheme(m->drw, colors[m->tagset[m->seltags] & 1 << i ? SchemeSel : SchemeNorm]);
+		drwl_text(m->drw, x, 0, w, m->b.height, m->lrpad / 2, tags[i], urg & 1 << i);
+		if (occ & 1 << i)
+			drwl_rect(m->drw, x + boxs, boxs, boxw, boxw,
+				m == selmon && c && c->tags & 1 << i,
+				urg & 1 << i);
+		x += w;
+	}
+	w = TEXTW(m, m->ltsymbol);
+	drwl_setscheme(m->drw, colors[SchemeNorm]);
+	x = drwl_text(m->drw, x, 0, w, m->b.height, m->lrpad / 2, m->ltsymbol, 0);
+
+	if (modes_labels[mode][0] != '\0') {
+		w = TEXTW(m, modes_labels[mode]);
+		drwl_setscheme(m->drw, colors[SchemeSel]);
+		x = drwl_text(m->drw, x, 0, w, m->b.height, m->lrpad / 2, modes_labels[mode], 0);
+	}
+
+	wlr_scene_buffer_set_dest_size(m->scene_buffer,
+		m->b.real_width, m->b.real_height);
+	wlr_scene_node_set_position(&m->scene_buffer->node, m->m.x + sp,
+		m->m.y + (topbar ? vp : m->m.height - m->b.real_height - vp));
+	wlr_scene_buffer_set_buffer(m->scene_buffer, &buf->base);
+	wlr_buffer_unlock(&buf->base);
+}
